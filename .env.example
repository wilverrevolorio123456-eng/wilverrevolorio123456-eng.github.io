# Copie este archivo como .env y complete valores seguros.
PORT=3000
NODE_ENV=development
# Genere una clave aleatoria larga. Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
# Configure true únicamente si el sitio está detrás de un proxy HTTPS confiable.
TRUST_PROXY=false
# Opcional: URL inicial del sistema de viáticos. Dejar vacío hasta verificarla.
SYSTEM_URL=
